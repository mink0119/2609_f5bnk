[Unit]
Description=PoC HTTP delay helper for coffee+tea (127.0.0.1:18080)
After=network.target

[Service]
Type=simple
Environment=POC_DELAY_HOST=127.0.0.1
Environment=POC_DELAY_PORT=18080
ExecStart=/usr/bin/python3 /etc/nginx/poc-delay.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
